<section class="space-y-6">
  <h2 class="text-2xl font-bold tracking-tight border-b border-slate-200 dark:border-slate-800 pb-2">Technical Skills</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none">
      <span class="font-semibold text-indigo-600 dark:text-indigo-400 block mb-1">Programming Languages</span>
      <p class="text-slate-700 dark:text-slate-300">PHP, SQL, JavaScript, Python</p>
    </div>
    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none">
      <span class="font-semibold text-indigo-600 dark:text-indigo-400 block mb-1">Frameworks</span>
      <p class="text-slate-700 dark:text-slate-300">Laravel, ReactJS, VueJS, TailwindCSS, AlpineJS, Livewire</p>
    </div>
    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none">
      <span class="font-semibold text-indigo-600 dark:text-indigo-400 block mb-1">Databases</span>
      <p class="text-slate-700 dark:text-slate-300">MySQL, SQLite, PostgreSQL</p>
    </div>
    <div class="p-4 rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none">
      <span class="font-semibold text-indigo-600 dark:text-indigo-400 block mb-1">Certifications</span>
      <p class="text-slate-700 dark:text-slate-300">Junior Web Developer (BNSP), TOEIC (855), Duolingo (120), UM EPT (554)</p>
    </div>
  </div>
</section>