---
import imawiproite from '../assets/projects/imawiproite.png';
import halal from '../assets/projects/halal.png';
import kaizen from '../assets/projects/kaizen.png';
import ticketing from '../assets/projects/ticketing.png';
import vcr from '../assets/projects/vcr.png';
import tfs from '../assets/projects/tfs.png';
import model from '../assets/projects/model.png';
import sisinta from '../assets/projects/sisinta.png';
import sintesis from '../assets/projects/sintesis.png';
import nadine from '../assets/projects/nadine.png';

const projects = [
  { name: "I'm a Wiproite", tech: "Laravel, React, TailwindCSS, MySQL, AWS S3, SSO, Multi-Language Translations", image: imawiproite },
  { name: "Halal Monitoring", tech: "Laravel, React, TailwindCSS, MySQL, AWS S3, SSO, Multi-Language Translations", image: halal },
  { name: "Kaizen Portal", tech: "Laravel, React, TailwindCSS, MySQL, AWS S3, SSO, Multi-Language Translations", image: kaizen },
  { name: "IT Ticketing System", tech: "Laravel, jQuery, Bootstrap, MySQL, SSO", image: ticketing },
  { name: "Vendor & Customer Registry", tech: "Laravel, jQuery, Bootstrap, MySQL, SAP FTP, SSO", image: vcr },
  { name: "Transport for Surabaya", tech: "Laravel, React, TailwindCSS, Geolocation, WebAuthn, Rest API", image: tfs },
  { name: "SDN Model Registration Portal", tech: "Laravel, VueJS, TailwindCSS, MySQL", image: model },
  { name: "Bachelor Thesis Tracker (SISINTA)", tech: "Laravel, Livewire, TailwindCSS, MySQL", image: sisinta },
  { name: "Master Thesis Tracker (SINTESIS)", tech: "Laravel, AlpineJS, jQuery, Bootstrap, MySQL", image: sintesis },
  { name: "Government E-Office", tech: "Codeigniter 3, Bootstrap, jQuery", image: nadine },
];
---
<section class="space-y-6">
  <h2 class="text-2xl font-bold tracking-tight border-b border-slate-200 dark:border-slate-800 pb-2">Projects</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project) => {
      const imgSrc = typeof project.image === 'object' && project.image !== null ? project.image.src : project.image;
      
      return (
        <div class="rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none flex flex-col overflow-hidden group">
          
          {/* Image wrapped in an anchor tag to open in a new tab */}
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="overflow-hidden block">
            <img 
              src={imgSrc} 
              alt={project.name} 
              class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300" 
            />
          </a>

          {/* Content Area */}
          <div class="p-4 flex flex-col flex-1 justify-between space-y-3">
            <h3 class="font-semibold text-slate-900 dark:text-slate-100">{project.name}</h3>
            <p class="text-xs text-indigo-600 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/40 p-2 rounded border border-indigo-100 dark:border-indigo-900/30 font-mono">{project.tech}</p>
          </div>

        </div>
      );
    })}
  </div>
</section>