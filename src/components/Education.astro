---
import um from '../assets/educations/um.png';
import smea from '../assets/educations/smea.png';

const educations = [
  { degree: "Master of Electrical Engineering • GPA 3.93", date: "Jan 2024 – Jan 2025", institution: "Universitas Negeri Malang (State University of Malang)", image: um },
  { degree: "B.Eng of Informatics • GPA 3.78", date: "September 2020 – Jan 2024", institution: "Universitas Negeri Malang (State University of Malang)", image: um },
  { degree: "Software Engineering", date: "Jul 2017 – May 2020", institution: "SMK Negeri 1 Banyuwangi", image: smea },
];
---
<section class="space-y-6">
  <h2 class="text-2xl font-bold tracking-tight border-b border-slate-200 dark:border-slate-800 pb-2">Education</h2>
  <div class="space-y-4 text-sm">
    {educations.map((edu) => (
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none flex items-center gap-4">
        <img src={typeof edu.image === 'object' && edu.image !== null ? edu.image.src : edu.image} alt={edu.institution} class="w-16 h-16 object-cover rounded-lg shrink-0 p-1.5 bg-white" />
        <div class="flex-1">
          <div class="flex justify-between items-center font-semibold text-slate-900 dark:text-slate-100">
            <span>{edu.degree}</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">{edu.date}</span>
          </div>
          <p class="text-indigo-600 dark:text-indigo-400">{edu.institution}</p>
        </div>
      </div>
    ))}
  </div>
</section>